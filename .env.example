# Production Environment Variables
# Copy to .env.production and modify as needed

# Application Settings
JOB_DASHBOARD_ENV=production
JOB_DASHBOARD_DEBUG=false
JOB_DASHBOARD_DATA_DIR=/app/data
JOB_DASHBOARD_LOG_LEVEL=INFO
JOB_DASHBOARD_HOST=0.0.0.0
JOB_DASHBOARD_PORT=8787

# Database Configuration
DATABASE_URL=sqlite:////app/data/jobs.sqlite3
# For PostgreSQL:
# DATABASE_URL=postgresql://job_user:job_password@postgres:5432/job_dashboard

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
API_RATE_LIMIT=60

# Cache Configuration
REDIS_URL=redis://redis:6379/0
CACHE_TTL=3600  # 1 hour
CACHE_MAX_SIZE=1024

# LLM Configuration (Optional)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key

# Job Sources Configuration
JOBSPY_ENABLE_SCRAPING=true
JOBSPY_RATE_LIMIT_DELAY=1.0
LINKEDIN_ENABLED=false
LINKEDIN_SESSION_COOKIE=
INDEED_ENABLED=true
GLASSDOOR_ENABLED=false

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
METRICS_PORT=9091

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@job-dashboard.com

# Webhook Configuration (Optional)
WEBHOOK_URL=https://your-webhook-url.com
WEBHOOK_SECRET=your-webhook-secret

# Feature Flags
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_SMART_RECOMMENDATIONS=true
ENABLE_RESUME_ANALYSIS=false
ENABLE_INTERVIEW_SIMULATION=false

# Performance Settings
MAX_WORKERS=4
BATCH_SIZE=50
QUERY_TIMEOUT=30