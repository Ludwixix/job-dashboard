# Job Dashboard Modular — Environment Variables
# Copy to .env and fill in values as needed. All variables are optional;
# the app runs with sensible defaults and degrades gracefully when a
# feature's credentials are missing (that source/feature is simply disabled).

# --- Data & directories ---
JOB_DASHBOARD_DATA_DIR=data
JOB_DASHBOARD_SOURCE_DIR=Source of truth
JOB_DASHBOARD_GUIDELINES_DIR=Guidelines
# JOB_DASHBOARD_EXAMPLES_DIR=data/Examples

# --- Server ---
JOB_DASHBOARD_HOST=127.0.0.1
JOB_DASHBOARD_PORT=8787
# Cloud Run injects PORT/HOST directly; JOB_DASHBOARD_HOST/PORT are used for local dev.

# --- Persistent job index backup (required for Cloud Run) ---
# Cloud Run's container filesystem is ephemeral: without this, the local
# SQLite job index resets to whatever was baked into the image on every
# cold start (scale-to-zero, redeploy). Set this to a GCS bucket the
# service's runtime identity can read/write, and the index is restored on
# startup and backed up after every successful refresh.
JOB_DASHBOARD_GCS_DATA_BUCKET=

# --- Job sources ---
JOB_DASHBOARD_SEEK_ENABLED=true
# JOB_DASHBOARD_SEEK_API_ENDPOINT=
JOB_DASHBOARD_SEEK_MAX_PAGES=3
JOB_DASHBOARD_SEEK_MAX_RESULTS=60
JOB_DASHBOARD_SEEK_PAUSE_SECONDS=1.5
JOB_DASHBOARD_SEEK_BROWSER_FALLBACK=true
JOB_DASHBOARD_SEEK_CACHE_FALLBACK=true
# JOB_DASHBOARD_SEEK_CACHE_PATH=

JOB_DASHBOARD_LINKEDIN_ENABLED=true

# Adzuna: required for the Adzuna source to return any results; without
# these it silently returns an empty list rather than erroring.
JOB_DASHBOARD_ADZUNA_APP_ID=
JOB_DASHBOARD_ADZUNA_API_KEY=

# --- LLM (resume/cover letter generation) ---
JOB_DASHBOARD_LLM_MODEL=deepseek/deepseek-v4-flash-0731
JOB_DASHBOARD_OPENROUTER_API_KEY=

# --- Gmail (application-status scanning) ---
JOB_DASHBOARD_GMAIL_USERNAME=
JOB_DASHBOARD_GMAIL_APP_PASSWORD=

# --- Application behavior ---
# How often the background sync loop re-runs app.refresh() (seconds).
JOB_DASHBOARD_SYNC_INTERVAL_SECONDS=1800
# Only jobs posted within this many days are admitted by a fresh scrape.
JOB_DASHBOARD_RECENT_JOB_DAYS=14

# --- Security ---
# Used to sign JWTs (see security.py). Set a real random value in
# production; a random key is generated per-process if unset (which
# invalidates existing sessions on every restart).
JWT_SECRET_KEY=

ENABLE_RESUME_ANALYSIS=false
ENABLE_INTERVIEW_SIMULATION=false

# Performance Settings
MAX_WORKERS=4
BATCH_SIZE=50
QUERY_TIMEOUT=30