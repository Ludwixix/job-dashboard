import { JobApplication, JobActionUpdatePayload } from '@/types/job';
import { api } from '@/api/client';

export const useOptimisticJobAction = () => {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: async ({ jobId, payload }: { jobId: string; payload: JobActionUpdatePayload }) => {
      const response = await api.patch<JobApplication>(`/api/v1/jobs/${jobId}/events`, payload);
      return response.data;
    },
    onMutate: async ({ jobId, payload }) => {
      await queryClient.cancelQueries({ queryKey: ['jobs', 'triage-feed'] });
      await queryClient.cancelQueries({ queryKey: ['jobs', 'detail', jobId] });

      const previousFeed = queryClient.getQueryData<JobApplication[]>(['jobs', 'triage-feed']);
      const previousDetail = queryClient.getQueryData<JobApplication>(['jobs', 'detail', jobId]);

      if (previousFeed) {
        queryClient.setQueryData<JobApplication[]>(
          ['jobs', 'triage-feed'],
          previousFeed.map((job) =>
            job.id === jobId
              ? {
                  ...job,
                  macro_stage: payload.macro_stage || job.macro_stage,
                  last_micro_event: payload.event_type,
                  version: job.version + 1,
                  updated_at: new Date().toISOString(),
                }
              : job
          )
        );
      }

      return { previousFeed, previousDetail, jobId };
    },
    onError: (_err, _variables, context) => {
      if (context?.previousFeed) {
        queryClient.setQueryData(['jobs', 'triage-feed'], context.previousFeed);
      }
      if (context?.previousDetail) {
        queryClient.setQueryData(['jobs', 'detail', context.jobId], context.previousDetail);
      }
    },
    onSettled: (_data, _error, variables) => {
      queryClient.invalidateQueries({ queryKey: ['jobs', 'triage-feed'] });
      queryClient.invalidateQueries({ queryKey: ['jobs', 'detail', variables.jobId] });
    },
  });
};
Idempotent Endpoints and Optimistic Concurrency Control in FastAPIDistributed cloud environments like Google Cloud Run scale horizontally and can process asynchronous events out of order. To prevent race conditions and concurrent write hazards, the backend combines version-based Optimistic Concurrency Control (OCC) with idempotent event tracking.The primary JobApplication table includes an integer version column managed by SQLAlchemy's version_id_col. Every state-modifying payload must include an expected_version property matching the client's current snapshot. If a concurrent operation increments the version before the write completes, the engine detects the mismatch and raises a StaleDataError, which the API handles as an HTTP 409 Conflict. Network retries use an Idempotency-Key header, allowing the system to return existing event records without repeating state modifications.Pythonfrom datetime import datetime
from sqlalchemy import Column, String, Integer, DateTime, ForeignKey, Enum as SQLEnum
from sqlalchemy.orm import relationship
from app.db.base_class import Base
from app.schemas.enums import MacroStage, MicroEventType

class JobApplication(Base):
    __tablename__ = "job_applications"

    id = Column(String(36), primary_key=True, index=True)
    company_name = Column(String(255), nullable=False)
    role_title = Column(String(255), nullable=False)
    macro_stage = Column(SQLEnum(MacroStage), nullable=False, default=MacroStage.LEAD, index=True)
    version = Column(Integer, nullable=False, default=1)
    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
    updated_at = Column(DateTime, default=datetime.utcnow, onupdate=datetime.utcnow, nullable=False)

    events = relationship("ApplicationEvent", back_populates="application", cascade="all, delete-orphan")

    __mapper_args__ = {
        "version_id_col": version
    }

class ApplicationEvent(Base):
    __tablename__ = "application_events"

    id = Column(String(36), primary_key=True, index=True)
    application_id = Column(String(36), ForeignKey("job_applications.id"), nullable=False, index=True)
    event_type = Column(SQLEnum(MicroEventType), nullable=False)
    idempotency_key = Column(String(64), unique=True, index=True, nullable=True)
    payload_json = Column(String, nullable=True)
    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)

    application = relationship("JobApplication", back_populates="events")
Pythonfrom fastapi import APIRouter, Depends, HTTPException, Header, status
from sqlalchemy.orm import Session
from sqlalchemy.orm.exc import StaleDataError
from app.db.session import get_db
from app.models.job import JobApplication, ApplicationEvent
from app.schemas.job import JobEventCreate, JobApplicationResponse

router = APIRouter()

@router.patch("/{job_id}/events", response_model=JobApplicationResponse)
def dispatch_application_event(
    job_id: str,
    event_in: JobEventCreate,
    idempotency_key: str = Header(None, alias="Idempotency-Key"),
    db: Session = Depends(get_db)
):
    if idempotency_key:
        existing_event = db.query(ApplicationEvent).filter(
            ApplicationEvent.idempotency_key == idempotency_key
        ).first()
        if existing_event:
            return db.query(JobApplication).filter(JobApplication.id == job_id).one()

    job = db.query(JobApplication).filter(JobApplication.id == job_id).first()
    if not job:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="Application record missing")

    if event_in.expected_version != job.version:
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail=f"Stale resource version. Client sent {event_in.expected_version}, server holds {job.version}"
        )

    event_record = ApplicationEvent(
        id=event_in.event_id,
        application_id=job.id,
        event_type=event_in.event_type,
        idempotency_key=idempotency_key,
        payload_json=event_in.payload_json
    )
    db.add(event_record)

    if event_in.new_macro_stage:
        job.macro_stage = event_in.new_macro_stage

    try:
        db.commit()
        db.refresh(job)
    except StaleDataError:
        db.rollback()
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail="Optimistic concurrency collision detected. State has been mutated concurrently."
        )

    return job
Dimension C: Outcome-Based Adaptive Learning LoopsThe Closed-Loop Feedback ArchitectureThe platform's existing intelligence services (semantic_scoring.py and semantic_tailoring.py) operate without a mechanism to learn from real-world results. The scoring engine evaluates job description alignment against fixed criteria, while the tailoring service generates resumes using static templates. If resumes generated with a particular structural style consistently lead to rejections while another style regularly yields recruiter calls, the generation logic remains unchanged.Closing this loop requires treating resume variants, phrasing styles, and skill configurations as exploratory strategies within a Multi-Armed Bandit (MAB) framework. By linking pipeline outcomes back to the generation context, the application dynamically adjusts its prompts based on observed conversion rates.Mathematical Formulation of Attribution and Multi-Armed Bandit WeightingEach tailored asset generated by semantic_tailoring.py records a metadata vector $\mathbf{x} = \{a_{\text{style}}, \mathbf{k}_{\text{skills}}, d_{\text{density}}\}$ in an AssetTelemetry record. As an application moves through the pipeline, terminal transitions trigger a scalar outcome reward $R(e) \in [-1.0, +3.0]$:$$R(e) = \begin{cases}  +3.0 & \text{if } e \in \{\text{OFFER\_RECEIVED}\} \\ +1.5 & \text{if } e \in \{\text{TECH\_INTERVIEW\_SCHEDULED}\} \\ +1.0 & \text{if } e \in \{\text{SCREEN\_SCHEDULED}\} \\ -0.5 & \text{if } e \in \{\text{REJECTION\_RECEIVED}\} \text{ and } \Delta t \le 72\text{h (Resume Screen Failure)} \\ -0.2 & \text{if } e \in \{\text{APPLICATION\_GHOSTED}\} \\ 0.0 & \text{otherwise} \end{cases}$$Style archetypes (such as STAR_METRIC, ARCHITECTURAL_DECISION, and LEADERSHIP_IMPACT) are evaluated using an Exponential Moving Average (EMA) update rule:$$Q(a) \leftarrow (1 - \alpha) Q(a) + \alpha R(e)$$Setting the learning rate $\alpha = 0.10$ stabilizes the estimates against noisy rejections while preserving sensitivity to genuine hiring signals. Action selection follows an $\epsilon$-Greedy policy with $\epsilon = 0.15$, maintaining continuous exploration of alternative phrasings.Skill-tag relevance is tracked using the point-biserial correlation coefficient $r_{k}$ between the presence of skill $k$ in tailored materials ($b_k \in \{0, 1\}$) and stage advancement ($y \in \{0, 1\}$):$$r_{k} = \frac{\bar{y}_{k=1} - \bar{y}}{\sigma_y} \sqrt{\frac{n_{k=1} n_{k=0}}{n^2}}$$Dynamic Prompt Context ModulationRather than training specialized models, the system injects observed performance metrics directly into runtime prompts. When generating resumes, semantic_tailoring.py queries OutcomeLearningEngine to retrieve high-performing phrasing styles and keyword weights, incorporating them directly into the instructions provided to the model.Pythonfrom typing import Dict, Any
from sqlalchemy.orm import Session
from sqlalchemy import func
from app.models.telemetry import AssetTelemetry, PhrasingArchetypeWeight

class OutcomeLearningEngine:
    def __init__(self, db: Session):
        self.db = db

    def get_tailoring_context_modifiers(self, target_domain: str) -> Dict[str, Any]:
        best_archetype = (
            self.db.query(PhrasingArchetypeWeight)
            .filter(PhrasingArchetypeWeight.domain == target_domain)
            .order_by(PhrasingArchetypeWeight.q_value.desc())
            .first()
        )
        selected_style = best_archetype.archetype_name if best_archetype else "STAR_METRIC"

        positive_keywords = (
            self.db.query(AssetTelemetry.skill_tag, func.avg(AssetTelemetry.outcome_reward).label("avg_reward"))
            .filter(AssetTelemetry.domain == target_domain)
            .group_by(AssetTelemetry.skill_tag)
            .having(func.count(AssetTelemetry.id) >= 3)
            .order_by(func.avg(AssetTelemetry.outcome_reward).desc())
            .limit(5)
            .all()
        )

        negative_keywords = (
            self.db.query(AssetTelemetry.skill_tag, func.avg(AssetTelemetry.outcome_reward).label("avg_reward"))
            .filter(AssetTelemetry.domain == target_domain)
            .group_by(AssetTelemetry.skill_tag)
            .having(func.count(AssetTelemetry.id) >= 3)
            .order_by(func.avg(AssetTelemetry.outcome_reward).asc())
            .limit(3)
            .all()
        )

        return {
            "style_directive": selected_style,
            "emphasized_skills": [kw[0] for kw in positive_keywords if kw[1] > 0.5],
            "suppressed_skills": [kw[0] for kw in negative_keywords if kw[1] < -0.2],
        }
