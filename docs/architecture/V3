def assemble_tailoring_system_prompt(domain: str, engine: OutcomeLearningEngine) -> str:
    calibration = engine.get_tailoring_context_modifiers(target_domain=domain)
    
    prompt = (
        "You are an expert technical resume tailoring agent specialized in software engineering.\n"
        f"CORE STYLISTIC DIRECTIVE: Structure experience bullets using {calibration['style_directive']}.\n"
