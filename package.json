{
  "name": "job-dashboard-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python3 -m job_dashboard.run_server --host 127.0.0.1 --port 8080",
    "dev:frontend": "cd frontend && npm run dev",
    "generate-openapi": "cd backend && PYTHONPATH=src python3 -m job_dashboard.openapi",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && python3 -m pytest tests/ -v",
    "test:frontend": "cd frontend && npm test -- --run",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
